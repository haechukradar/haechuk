---
import { SITE } from '../../config/site.mjs';
import { GAME } from '../../config/game.mjs';
import { PAGE_CLUBS } from '../../config/clubs.mjs';
import { loadData } from '../lib/data.mjs';
import { fmtKst } from '../lib/labels.mjs';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  wide?: boolean; // 보드·그리드 화면은 컨테이너 전체 폭, 나머지는 읽기 폭(800px)
}
const { title, description = SITE.tagline, noindex = false, wide = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const { meta } = loadData();
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <!-- 글꼴 CSS는 렌더링을 막지 않게 비동기로 (CDN이 느려도 시스템 글꼴로 먼저 표시) -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" /></noscript>
    <link rel="stylesheet" href="/style.css" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} 핫 트렌드`} href="/feed.xml" />
    {noindex ? <meta name="robots" content="noindex, follow" data-page-noindex /> : !SITE.searchIndexing && <meta name="robots" content="noindex, nofollow" />}
    {SITE.verification.naver && <meta name="naver-site-verification" content={SITE.verification.naver} />}
    {SITE.verification.google && <meta name="google-site-verification" content={SITE.verification.google} />}
    {
      SITE.ga4Id && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`} />
          <script is:inline define:vars={{ ga4Id: SITE.ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', ga4Id);
          </script>
        </>
      )
    }
    <script is:inline define:vars={{ gameConfig: GAME }}>
      window.GAME_CONFIG = gameConfig;
    </script>
    <script is:inline src="/game.js" defer></script>
    <script is:inline>
      // GA4 맞춤 이벤트 (측정 ID가 없으면 아무것도 보내지 않음)
      window.track = function (name, params) {
        if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
      };
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <a class="logo" href="/">⚽ {SITE.name}</a>
        <nav class="nav">
          <a href="/" class:list={{ on: path === '/' }}>홈</a>
          <a href="/clubs" class:list={{ on: path.startsWith('/club') }}>클럽</a>
          <a href="/players" class:list={{ on: path.startsWith('/korean') || path.startsWith('/player') }}>선수</a>
          <a href="/transfers" class:list={{ on: path.startsWith('/transfers') }}>이적 현황</a>
          <a href="/quiz" class:list={{ on: path.startsWith('/quiz') || path.startsWith('/me') }}>퀴즈</a>
          <a href="/archive" class:list={['nav-archive', { on: path.startsWith('/archive') }]}>아카이브</a>
        </nav>
      </div>
      <div class="wrap club-strip">
        {PAGE_CLUBS.map((c) => <a href={`/club/${c.slug}`} data-club={c.slug} class:list={{ on: path === `/club/${c.slug}` }}>{c.ko}</a>)}
      </div>
    </header>

    <main class="wrap">
      {wide ? <slot /> : <div class="page"><slot /></div>}
    </main>

    <footer class="foot">
      <div class="wrap">
        <p class="algo">
          본 사이트의 기사 배열은 <a href="/policy">공개된 기준</a>에 따른 <b>알고리즘 자동 배열</b>이며, 운영자가 개별 기사의 배열에 관여하지
          않습니다.
        </p>
        <p>
          모든 기사의 저작권은 각 언론사에 있습니다. 본 사이트는 기사 본문·이미지를 게재하지 않으며, 제목 정보 범위의 한국어 요약과 원문 링크만
          제공합니다. 요약은 AI가 생성하므로 오류가 있을 수 있으니 원문을 확인하세요.
        </p>
        {
          (SITE.arrangementManager || SITE.youthProtectionManager) && (
            <p>
              {SITE.arrangementManager && <>기사배열책임자: {SITE.arrangementManager} · </>}
              {SITE.youthProtectionManager && <>청소년보호책임자: {SITE.youthProtectionManager}</>}
            </p>
          )
        }
        <p class="links">
          <a href="/archive">뉴스 아카이브</a> · <a href="/me">내 기록</a> · <a href="/policy">기사배열 기본방침·운영원칙</a> · <a href="/privacy">개인정보 처리방침</a> · <a href={`mailto:${SITE.reportEmail}?subject=${encodeURIComponent('[삭제·정정 요청]')}`}>삭제·정정 요청</a>
          {SITE.spochatUrl && <> · <a href={SITE.spochatUrl} target="_blank" rel="noopener">SPOCHAT 심층 해설</a></>}
        </p>
        {meta.updatedAt && <p class="muted">마지막 수집: {fmtKst(meta.updatedAt)} (KST)</p>}
      </div>
    </footer>

    <script is:inline>
      // 내 클럽 즐겨찾기 (로그인 없이 이 브라우저에만 저장)
      (function () {
        var KEYS = { clubs: 'favClubs', players: 'favPlayers' };
        var FAV = {
          get: function (kind) {
            try { return JSON.parse(localStorage.getItem(KEYS[kind || 'clubs']) || '[]'); } catch (e) { return []; }
          },
          set: function (kind, list) {
            try { localStorage.setItem(KEYS[kind], JSON.stringify(list)); } catch (e) {}
            document.dispatchEvent(new CustomEvent('fav-change'));
          },
          toggle: function (slug, kind, name) {
            kind = kind || 'clubs';
            var list = FAV.get(kind);
            var i = list.indexOf(slug);
            var removing = i >= 0;
            if (removing) list.splice(i, 1); else list.push(slug);
            FAV.set(kind, list);
            window.track(removing ? 'favorite_remove' : 'favorite_add', { target_type: kind === 'players' ? 'player' : 'club', target_name: name || slug });
          },
        };
        window.FAV = FAV;
        function render() {
          var favs = FAV.get('clubs');
          // 상단 클럽 바: 내 클럽을 앞으로
          var strip = document.querySelector('.club-strip');
          if (strip) {
            var links = Array.prototype.slice.call(strip.querySelectorAll('a[data-club]'));
            links.forEach(function (a) { a.classList.toggle('fav', favs.indexOf(a.getAttribute('data-club')) >= 0); });
            links
              .sort(function (x, y) { return (y.classList.contains('fav') ? 1 : 0) - (x.classList.contains('fav') ? 1 : 0); })
              .forEach(function (a) { strip.appendChild(a); });
          }
          // 별 버튼 상태
          document.querySelectorAll('[data-fav-toggle]').forEach(function (b) {
            var kind = b.getAttribute('data-fav-kind') || 'clubs';
            var on = FAV.get(kind).indexOf(b.getAttribute('data-fav-toggle')) >= 0;
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
            b.classList.toggle('on', on);
            var noun = kind === 'players' ? '선수' : '클럽';
            b.textContent = on ? (b.getAttribute('data-label-on') || '★ 내 ' + noun) : (b.getAttribute('data-label-off') || '☆ 내 ' + noun + ' 추가');
          });
        }
        document.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('[data-fav-toggle]');
          if (!b) return;
          e.preventDefault();
          FAV.toggle(b.getAttribute('data-fav-toggle'), b.getAttribute('data-fav-kind') || 'clubs', b.getAttribute('data-fav-name'));
        });
        document.addEventListener('fav-change', render);
        document.addEventListener('DOMContentLoaded', render);
      })();

      // 이슈 카드 안의 SPOCHAT 배지: 카드 링크 대신 해설 글을 새 탭으로
      document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('.commentary-badge[data-href]');
        if (!b) return;
        e.preventDefault();
        e.stopPropagation();
        window.open(b.getAttribute('data-href'), '_blank', 'noopener');
      }, true);

      // 원문 이동·오류 신고 이벤트
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a');
        if (!a) return;
        if (a.hasAttribute('data-out')) window.track('outbound_click', { source_name: a.getAttribute('data-src-name'), tier: Number(a.getAttribute('data-tier')) });
        else if (a.classList.contains('report')) window.track('report_error', { link_url: a.getAttribute('data-article') || '' });
      });

      // 공신력 필터 (전체 · T1·T2만 · 핫이슈만) — 피드 카드의 data-tier, data-hot 기준, 선택은 브라우저에 저장
      (function () {
        var KEY = 'tierFilter';
        function get() {
          try { return localStorage.getItem(KEY) || 'all'; } catch (e) { return 'all'; }
        }
        function pass(el, f) {
          if (f === 't12') return Number(el.getAttribute('data-tier')) <= 2;
          if (f === 'hot') return el.getAttribute('data-hot') === '1';
          return true;
        }
        function apply() {
          var f = get();
          document.querySelectorAll('.seg[data-tier-filter] button').forEach(function (b) {
            b.classList.toggle('on', b.getAttribute('data-value') === f);
            b.setAttribute('aria-pressed', b.getAttribute('data-value') === f ? 'true' : 'false');
          });
          document.querySelectorAll('[data-filterable]').forEach(function (box) {
            var shown = 0;
            box.querySelectorAll('[data-tier]').forEach(function (c) {
              c.classList.toggle('f-tier-hide', !pass(c, f));
              if (!c.hidden && !c.classList.contains('f-tier-hide')) shown++;
            });
            var empty = document.querySelector('.filter-empty[data-for="' + box.id + '"]');
            if (empty) empty.hidden = shown > 0 || box.querySelectorAll('[data-tier]').length === 0;
            box.dispatchEvent(new CustomEvent('filter-applied', { detail: { shown: shown } }));
          });
        }
        function set(f) {
          try { localStorage.setItem(KEY, f); } catch (e) {}
          apply();
        }
        document.addEventListener('click', function (e) {
          var b = e.target.closest && e.target.closest('.seg[data-tier-filter] button');
          if (b) {
            set(b.getAttribute('data-value'));
            window.track('filter_tier_toggle', { filter: b.getAttribute('data-value') });
            return;
          }
          var r = e.target.closest && e.target.closest('[data-filter-reset]');
          if (r) {
            set('all');
            document.dispatchEvent(new CustomEvent('feed-filter-reset'));
            apply();
          }
        });
        window.__applyFeedFilters = apply;
        document.addEventListener('DOMContentLoaded', apply);
      })();

      // 경과 시간 표시 (정적 페이지이므로 브라우저에서 계산)
      (function () {
        function ago(ts) {
          var m = Math.floor((Date.now() - ts) / 60000);
          if (m < 1) return '방금';
          if (m < 60) return m + '분 전';
          var h = Math.floor(m / 60);
          if (h < 24) return h + '시간 전';
          return Math.floor(h / 24) + '일 전';
        }
        function tick() {
          document.querySelectorAll('time[data-ts]').forEach(function (el) {
            el.textContent = ago(Date.parse(el.getAttribute('data-ts')));
          });
        }
        window.__tickAgo = tick;
        window.__ago = ago;
        tick();
        setInterval(tick, 60000);
      })();
    </script>
  </body>
</html>

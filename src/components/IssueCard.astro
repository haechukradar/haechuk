---
// 이슈 카드: 여러 매체 보도를 하나로 묶은 단위
import { sourceOf } from '../lib/data.mjs';
import { bestReport } from '../../config/tiers.mjs';
import { STAGE_LABEL, CATEGORY_LABEL, stageChangeInfo, isRecentChange } from '../lib/labels.mjs';
import { commentaryFor } from '../../config/commentary.mjs';
import { PIPELINE } from '../../config/site.mjs';

interface Props {
  issue: any;
  rank?: number;
  hot?: boolean;
  hero?: boolean; // 메인 1위 이슈 (큰 곡면 카드는 이것 하나)
}
const { issue, rank, hot = false, hero = false } = Astro.props;
const title = issue.titleKo || issue.headline;
const best = bestReport(issue.articles);
const last = issue.articles.at(-1);
const commentary = commentaryFor(issue.slug);
const change = isRecentChange(issue.stageChange) ? stageChangeInfo(issue.stageChange) : null;
---

<a class:list={['issue', { hot, hero }]} href={`/issue/${issue.slug}`} data-clubs={issue.clubs.join(' ')} data-tier={issue.topTier} data-hot={issue.recentSources >= PIPELINE.hotMinSources ? '1' : '0'}>
  <div class="issue-head">
    {rank && <span class="rank">{rank}</span>}
    {hot && <span class="fire" title="다매체 동시 보도">🔥</span>}
    {issue.stage ? <span class={`stage stage-${issue.stage}`}>{STAGE_LABEL[issue.stage]}</span> : <span class="cat">{CATEGORY_LABEL[issue.category] ?? '일반'}</span>}
    <strong class="issue-title">{title}</strong>
  </div>
  {issue.titleKo && <p class="orig">{issue.headline}</p>}
  {
    change && (
      <p class={`change change-${change.kind}`}>
        {change.icon} 단계 {change.kind === 'up' ? '진전' : '변화'}: {change.text} · <time data-ts={issue.stageChange.at} datetime={issue.stageChange.at}></time>
      </p>
    )
  }
  {commentary && <span class="commentary-badge" role="link" tabindex="0" data-href={commentary.url}>📝 심층 해설 (SPOCHAT) →</span>}
  <div class="meta">
    <span>{issue.sourceCount}개 매체</span>
    <span class={`tier tier-${best.tier}`}>최고 T{best.tier} · {best.name}{best.note && ` (${best.note})`}</span>
    <span>최초: {issue.firstReport.name}{sourceOf(issue.firstReport.source ?? '').paywall ? ' 🔒' : ''}</span>
    <time data-ts={last.publishedAt} datetime={last.publishedAt}></time>
  </div>
</a>

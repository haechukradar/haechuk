---
// 커리어 퀴즈 "나 누구게?": 선수의 클럽 경력 경로를 보고 선수를 맞힌다 (샘플 1문제)
// 문제 데이터: data/career/YYYY-MM-DD.json — 경력은 출처로 확인한 뒤 등록 (verified, sources)
import Layout from '../../layouts/Layout.astro';
import { clubBadge } from '../../../config/badges.mjs';
import { existsSync, readdirSync, readFileSync } from 'node:fs';
import path from 'node:path';

const dir = path.resolve('data/career');
const files = existsSync(dir) ? readdirSync(dir).filter((f) => f.endsWith('.json')).sort().reverse() : [];
const q = files.length ? JSON.parse(readFileSync(path.join(dir, files[0]), 'utf8')) : null;
const steps = q ? q.path.map((s: any) => ({ ...s, b: clubBadge(s.club) })) : [];
---

<Layout title="커리어 퀴즈 · 나 누구게?" description="클럽 경력만 보고 선수를 맞혀 보세요.">
  <h1 class="page-title">나 누구게? <small>커리어 퀴즈</small></h1>

  {q ? (
    <section class="career" data-id={q.id} data-answer={q.answer}>
      <p class="muted small">이 선수가 거쳐 간 클럽입니다. 누구일까요? · 난이도 {q.level}</p>

      <ol class="cpath">
        {steps.map((s: any, n: number) => (
          <li class:list={['cstep', { loan: s.loan }]}>
            {n > 0 && <span class="carrow" aria-hidden="true">{s.loan ? '⇢' : '→'}</span>}
            <span class="cclub">
              <span class="badge cbadge" style={s.b.bg ? `background:${s.b.bg};color:${s.b.fg}` : undefined}>{s.b.text}</span>
              <span class="cname">{s.b.ko}</span>
              {s.loan && <span class="ctag">임대</span>}
              {s.return && <span class="ctag">복귀</span>}
              <span class="cyears" hidden>{s.years}</span>
            </span>
          </li>
        ))}
      </ol>

      <div class="chints">
        {q.hints.map((h: any, n: number) => (
          <button type="button" class="fav-btn chint" data-n={n} data-text={h.text} data-years={h.label === '시기' ? '1' : undefined}>
            힌트 {n + 1} · {h.label}
          </button>
        ))}
      </div>
      <p class="small chint-out" aria-live="polite"></p>

      <div class="qopts copts">
        {q.options.map((o: string) => (
          <button type="button" class="qopt" data-choice={o}>{o}</button>
        ))}
      </div>

      <div class="cresult" hidden>
        <p class="cverdict"></p>
        <p class="qexplain">{q.explain}</p>
        <p class="muted small">경력 출처: {q.sources.map((u: string, i: number) => <><a href={u} target="_blank" rel="noopener nofollow">{new URL(u).hostname}</a>{i < q.sources.length - 1 && ', '}</>)}</p>
      </div>
    </section>
  ) : (
    <p class="empty">아직 출제된 문제가 없습니다.</p>
  )}
</Layout>

<script is:inline>
  (function () {
    var box = document.querySelector('.career');
    if (!box) return;
    var KEY = 'fr.career';
    var id = box.getAttribute('data-id');
    var answer = box.getAttribute('data-answer');
    var load = function () { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; } };
    var save = function (s) { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) {} };
    var state = load();
    var mine = state[id] || { hints: 0, pick: null };
    var out = box.querySelector('.chint-out');

    function showYears() { box.querySelectorAll('.cyears').forEach(function (y) { y.hidden = false; }); }
    function renderHints() {
      var texts = [];
      box.querySelectorAll('.chint').forEach(function (b) {
        var n = Number(b.getAttribute('data-n'));
        var open = n < mine.hints;
        b.disabled = open || n > mine.hints || !!mine.pick;
        if (open) {
          texts.push(b.textContent.replace(/^힌트 \d+ · /, '') + ': ' + b.getAttribute('data-text'));
          if (b.getAttribute('data-years')) showYears();
        }
      });
      out.textContent = texts.join(' · ');
    }
    function renderResult() {
      if (!mine.pick) return;
      var right = mine.pick === answer;
      box.querySelectorAll('.qopt').forEach(function (b) {
        var c = b.getAttribute('data-choice');
        b.disabled = true;
        if (c === answer) b.classList.add('right');
        if (c === mine.pick) b.classList.add('picked', right ? 'right' : 'wrong');
      });
      showYears();
      box.querySelector('.cverdict').innerHTML = right
        ? '<b>정답!</b> ' + answer + (mine.hints ? ' · 힌트 ' + mine.hints + '개 사용' : ' · 힌트 없이 맞혔어요')
        : '아쉬워요. 정답은 <b>' + answer + '</b>';
      box.querySelector('.cresult').hidden = false;
      renderHints();
    }
    box.addEventListener('click', function (e) {
      var h = e.target.closest('.chint');
      if (h && !h.disabled) {
        mine.hints = Number(h.getAttribute('data-n')) + 1;
        state[id] = mine; save(state);
        renderHints();
        return;
      }
      var o = e.target.closest('.qopt');
      if (o && !o.disabled && !mine.pick) {
        mine.pick = o.getAttribute('data-choice');
        state[id] = mine; save(state);
        if (window.track) window.track('career_quiz_answer', { quiz_id: id, correct: mine.pick === answer, hints: mine.hints });
        renderResult();
      }
    });
    renderHints();
    renderResult();
  })();
</script>
